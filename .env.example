# Обязательно заменить перед любым внешним запуском.
AUTH_SECRET=replace-with-at-least-32-random-characters

# HTTP-шлюз почтового провайдера. Без него локальные коды показываются в интерфейсе.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=

# Telegram Bot API. Без этих значений работает локальный симулятор бота.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
